PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/kivora-ai
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ENCRYPTION_KEY=replace_with_a_long_random_secret_used_to_encrypt_stored_user_api_keys
FREE_DAILY_LIMIT=5
# Minimum 32 characters — generate with: node -e "console.log(crypto.randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_min_32_chars_long_replace_me
JWT_EXPIRES_IN=1d
ALLOWED_ORIGINS=http://localhost:4500,http://127.0.0.1:4500
# Optional — powers ingredient + recipe photos via Pexels. The feature no-ops
# gracefully (letter-tile fallbacks everywhere) if this is left unset.
PEXELS_API_KEY=your_pexels_api_key_here

